# ============================================================
# APPLICATION
# ============================================================
APP_NAME="Attendance System"
APP_VERSION="1.0.0"
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ============================================================
# DATABASE (PostgreSQL)
# ============================================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=attendance_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# ============================================================
# SECURITY
# ============================================================
SECRET_KEY=change-this-to-a-very-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================================
# CORS
# ============================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================
# SUPERADMIN BOOTSTRAP
# ============================================================
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=Admin@123
ADMIN_ID_PEGAWAI=SA001
ADMIN_NIP=000000000000
ADMIN_NAMA=Super Administrator
ADMIN_JENIS_KELAMIN=L
ADMIN_TEMPAT_LAHIR=Jakarta
ADMIN_TANGGAL_LAHIR=1990-01-01
ADMIN_ALAMAT=Jakarta
ADMIN_STATUS=Aktif
ADMIN_FORCE_UPDATE=false
